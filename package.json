{
  "name": "oh8oh",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:wrangler": "wrangler dev",
    "build": "vite build && node -e \"const fs=require('fs'),path=require('path');fs.readdirSync('dist').filter(f=>f==='sw.js'||f.startsWith('workbox-')).forEach(f=>fs.copyFileSync(path.join('dist',f),path.join('.output','public',f)))\"",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier",
    "check": "prettier --write . && eslint --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "powershell -ExecutionPolicy Bypass -File ./scripts/migrate.ps1",
    "db:migrate:prod": "powershell -ExecutionPolicy Bypass -File ./scripts/migrate.ps1 -Environment production",
    "db:studio": "drizzle-kit studio",
    "cf:deploy": "VITE_AUTH_URL=https://oh8oh.mohansky.workers.dev pnpm build && wrangler --cwd .output/ deploy",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.954.0",
    "@base-ui/react": "^1.0.0",
    "@better-auth/passkey": "^1.4.7",
    "@fontsource-variable/figtree": "^5.2.10",
    "@libsql/client": "^0.17.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.6",
    "@tabler/icons-react": "^3.36.0",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-form": "^1.27.4",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-router-ssr-query": "^1.131.7",
    "@tanstack/react-start": "^1.132.0",
    "@tanstack/router-plugin": "^1.132.0",
    "axios": "^1.13.2",
    "better-auth": "^1.4.7",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.561.0",
    "nanoid": "^5.1.6",
    "next-themes": "^0.4.6",
    "nitro": "3.0.1-alpha.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-day-picker": "^9.12.0",
    "react-dom": "^19.2.0",
    "react-email": "^5.2.10",
    "resend": "^6.9.4",
    "shadcn": "^3.6.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.0.6",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.0.4",
    "@cloudflare/vite-plugin": "^1.17.1",
    "@cloudflare/workers-types": "^4.20260103.0",
    "@tanstack/devtools-vite": "^0.3.11",
    "@tanstack/eslint-config": "^0.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.8",
    "jsdom": "^27.0.0",
